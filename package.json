{
  "name": "ssp-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluation:policy:bundle": "node_modules\\@esbuild\\win32-x64\\esbuild.exe scripts/run-policy-evaluation.ts --bundle --platform=node --format=esm --outfile=.evaluation-tmp/run-policy-evaluation.mjs",
    "evaluation:policy:verify": "npm run evaluation:policy:bundle && node .evaluation-tmp/run-policy-evaluation.mjs --check --mode all",
    "evaluation:policy:verify:node": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-type-strip-loader.mjs scripts/verify-policy-evaluator-direct.ts && node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-type-strip-loader.mjs scripts/run-policy-evaluation.ts --check --mode all",
    "evaluation:policy:run": "npm run evaluation:policy:bundle && node .evaluation-tmp/run-policy-evaluation.mjs --mode all --output evaluation-reports",
    "evaluation:policy": "npm run evaluation:policy:run",
    "evaluation:task3:verify:node": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-type-strip-loader.mjs scripts/verify-task-3-direct.ts",
    "evaluation:task3": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-type-strip-loader.mjs scripts/run-task-3-evaluation.ts",
    "evaluation:task4:verify:node": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-type-strip-loader.mjs scripts/verify-task-4-direct.ts",
    "evaluation:task4": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-type-strip-loader.mjs scripts/run-task-4-evaluation.ts --run",
    "seed": "npx tsx src/lib/db/seed/index.ts",
    "migrate:regression-test-expectations": "tsx scripts/migrate-regression-test-expectations.ts",
    "seed:showcase:offline": "tsx scripts/generate-showcase-cases.ts --fallback-only"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.33",
    "@ai-sdk/react": "^3.0.103",
    "@assistant-ui/react": "^0.12.14",
    "@assistant-ui/react-ai-sdk": "^1.3.10",
    "@assistant-ui/react-markdown": "^0.12.5",
    "@auth/drizzle-adapter": "^1.11.1",
    "@neondatabase/serverless": "^1.0.2",
    "@types/bcryptjs": "^2.4.6",
    "ai": "^6.0.99",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "json-logic-js": "^2.0.5",
    "lucide-react": "^0.575.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "openai": "^6.25.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
