{
  "dsl_version": "SOCILA-DSL-1.0",
  "rule_id": "R-400-UNEMPLOYMENT-ELIGIBILITY",
  "name": "失业金领取资格初判（简化：失业状态+失业险年限）",
  "module": "unemployment",
  "status": "published",
  "priority": 400,
  "effective_from": "2024-01-01",
  "effective_to": null,
  "supersedes": [],
  "notes": "仅做初判；真实资格还涉及非本人意愿中断就业、求职登记、年龄等条件，应在 Admin 中配置补充规则或标记需人工核对。",
  "inputs": [
    {
      "key": "user.status.employment_status",
      "type": "string",
      "required": true
    },
    {
      "key": "user.social.unemployment_insurance_years",
      "type": "number",
      "required": false
    }
  ],
  "parameter_refs": [],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_not_unemployed",
        "when": {
          "!=": [
            {
              "var": "user.status.employment_status"
            },
            "unemployed"
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.unemployment.eligible",
              "value": false
            }
          ]
        }
      },
      {
        "row_id": "row_2_missing_years",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "user.status.employment_status"
                },
                "unemployed"
              ]
            },
            {
              "==": [
                {
                  "var": "user.social.unemployment_insurance_years"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.unemployment.eligible",
              "value": null
            },
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_question",
              "value": {
                "question_id": "Q-UI-YEARS",
                "text": "请提供失业保险累计缴费年限（用于核算可领失业金月数）。",
                "field": "user.social.unemployment_insurance_years"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_3_years_ge_1",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "user.status.employment_status"
                },
                "unemployed"
              ]
            },
            {
              ">=": [
                {
                  "var": "user.social.unemployment_insurance_years"
                },
                1
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.unemployment.eligible",
              "value": true
            }
          ]
        }
      },
      {
        "row_id": "row_4_years_lt_1",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "user.status.employment_status"
                },
                "unemployed"
              ]
            },
            {
              "<": [
                {
                  "var": "user.social.unemployment_insurance_years"
                },
                1
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.unemployment.eligible",
              "value": false
            },
            {
              "type": "emit_warning",
              "value": {
                "warning_id": "W-UI-NOT-ELIGIBLE",
                "text": "失业险缴费年限不足1年，可能无法领取失业金（需以经办核定为准）。"
              }
            }
          ]
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "calc.unemployment.eligible",
      "type": "boolean"
    },
    {
      "key": "calc.needs_agent",
      "type": "boolean"
    },
    {
      "key": "calc.agent_questions",
      "type": "array"
    },
    {
      "key": "calc.warnings",
      "type": "array"
    }
  ],
  "examples": [
    {
      "name": "失业且失业险2年 -> eligible",
      "input": {
        "user": {
          "status": {
            "employment_status": "unemployed"
          },
          "social": {
            "unemployment_insurance_years": 2
          }
        }
      },
      "expected": {
        "calc": {
          "unemployment": {
            "eligible": true
          }
        }
      }
    }
  ],
  "evidence": [
    {
      "document_id": "DOC-CN-SOCIAL-INSURANCE-LAW",
      "jurisdiction_code": "CN",
      "title": "中华人民共和国社会保险法（2018修正）",
      "authority": "全国人民代表大会常务委员会",
      "official_url": "https://www.mohrss.gov.cn/xxgk2020/fdzdgknr/zcfg/fl/202011/t20201102_394629.html",
      "fetched_at": "2026-09-05T13:38:56.250Z",
      "content_sha256": "b69d5d490f9b6b70394dfb670c2e1a0a959f306e70380bb678ee4866f947d464",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/CN/DOC-CN-SOCIAL-INSURANCE-LAW/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "article",
        "reference": "第四十五条"
      },
      "excerpt": "失业人员符合下列条件的，从失业保险基金中领取失业保险金：（一）失业前用人单位和本人已经缴纳失业保险费满一年的；（二）非因本人意愿中断就业的；（三）已经进行失业登记，并有求职要求的。"
    },
    {
      "document_id": "DOC-CN-UNEMPLOYMENT-REGULATION",
      "jurisdiction_code": "CN",
      "title": "失业保险条例（国务院令第258号）",
      "authority": "国务院",
      "official_url": "https://www.mohrss.gov.cn/xxgk2020/fdzdgknr/zcfg/fg/202011/t20201103_394936.html",
      "fetched_at": "2026-09-05T13:43:01.660Z",
      "content_sha256": "b8187965656565984549569e9894a62cb3960f5a64aacac3749b80be2d7a3e04",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/CN/DOC-CN-UNEMPLOYMENT-REGULATION/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "article",
        "reference": "第十四条"
      },
      "excerpt": "具备下列条件的失业人员，可以领取失业保险金：（一）按照规定参加失业保险，所在单位和本人已按照规定履行缴费义务满1年的；（二）非因本人意愿中断就业的；（三）已办理失业登记，并有求职要求的。"
    }
  ],
  "operation": "baseline"
}
