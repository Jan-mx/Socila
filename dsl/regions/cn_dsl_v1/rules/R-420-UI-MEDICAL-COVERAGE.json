{
  "dsl_version": "SOCILA-DSL-1.0",
  "rule_id": "R-420-UI-MEDICAL-COVERAGE",
  "name": "失业金期间医保由基金代缴提示（规划成本口径）",
  "module": "unemployment",
  "status": "published",
  "priority": 420,
  "effective_from": "2024-01-01",
  "effective_to": null,
  "supersedes": [],
  "notes": "",
  "inputs": [
    {
      "key": "user.status.on_unemployment_benefit",
      "type": "boolean",
      "required": false
    }
  ],
  "parameter_refs": [],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_on_benefit",
        "when": {
          "==": [
            {
              "var": "user.status.on_unemployment_benefit"
            },
            true
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.mi.paid_by_unemployment_fund",
              "value": true
            },
            {
              "type": "emit_warning",
              "value": {
                "warning_id": "W-UI-MI-PAID",
                "text": "失业金期间，医保通常由失业保险基金代缴（以经办口径为准）。规划现金流时请不要重复计算医保个人缴费。"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_2_not_on_benefit_or_unknown",
        "when": {
          "or": [
            {
              "==": [
                {
                  "var": "user.status.on_unemployment_benefit"
                },
                false
              ]
            },
            {
              "==": [
                {
                  "var": "user.status.on_unemployment_benefit"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.mi.paid_by_unemployment_fund",
              "value": false
            }
          ]
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "calc.mi.paid_by_unemployment_fund",
      "type": "boolean"
    },
    {
      "key": "calc.warnings",
      "type": "array"
    }
  ],
  "examples": [
    {
      "name": "正在领取失业金 -> 医保基金代缴提示",
      "input": {
        "user": {
          "status": {
            "on_unemployment_benefit": true
          }
        }
      },
      "expected": {
        "calc": {
          "mi": {
            "paid_by_unemployment_fund": true
          }
        }
      }
    }
  ],
  "evidence": [
    {
      "document_id": "DOC-CN-SOCIAL-INSURANCE-LAW",
      "jurisdiction_code": "CN",
      "title": "中华人民共和国社会保险法（2018修正）",
      "authority": "全国人民代表大会常务委员会",
      "official_url": "https://www.mohrss.gov.cn/xxgk2020/fdzdgknr/zcfg/fl/202011/t20201102_394629.html",
      "fetched_at": "2026-09-05T13:38:56.250Z",
      "content_sha256": "b69d5d490f9b6b70394dfb670c2e1a0a959f306e70380bb678ee4866f947d464",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/CN/DOC-CN-SOCIAL-INSURANCE-LAW/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "article",
        "reference": "第四十八条"
      },
      "excerpt": "失业人员在领取失业保险金期间，参加职工基本医疗保险，享受基本医疗保险待遇。失业人员应当缴纳的基本医疗保险费从失业保险基金中支付，个人不缴纳基本医疗保险费。"
    }
  ],
  "operation": "baseline"
}
