    {
      "rule_id": "R-110-LOOKUP-LEGAL-RETIRE-AGE",
      "example_name": "1965-01男 -> 60岁1个月（渐进延迟首档）",
      "input": {
        "user": {
          "basic": {
            "gender": "male",
            "female_retire_type": "na",
            "birth_year": 1965,
            "birth_month": 1,
            "birth_date": "1965-01-15"
          }
        }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "retirement": {
            "legal_retire_age_years": 60,
            "legal_retire_age_months": 1,
            "original_retire_age_years": 60
          }
        }
      }
    },
    {
      "rule_id": "R-110-LOOKUP-LEGAL-RETIRE-AGE",
      "example_name": "覆盖表 1973男 -> 60",
      "input": {
        "user": {
          "basic": {
            "gender": "male",
            "female_retire_type": "na",
            "birth_year": 1973
          }
        }
      },
      "params_override": {
        "T-RETIREMENT-AGE-LOOKUP": [
          {
            "gender": "male",
            "female_retire_type": "na",
            "birth_year_min": 1900,
            "birth_year_max": 2100,
            "legal_retire_age_years": 60
          }
        ]
      },
      "expected": {
        "calc": {
          "retirement": {
            "legal_retire_age_years": 60
          }
        }
      }
    },
    {
      "rule_id": "R-115-FLEXIBLE-RETIREMENT",
      "example_name": "弹性最早：61岁5个月男职工提前至不低于原法定60岁",
      "input": {
        "user": {
          "basic": {
            "retire_preference": "earliest"
          }
        },
        "calc": {
          "retirement": {
            "legal_retire_age_years": 61,
            "legal_retire_age_months": 5,
            "original_retire_age_years": 60
          }
        }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "retirement": {
            "flex_adjusted": true,
            "flex_preference": "earliest",
            "legal_retire_age_years": 60,
            "legal_retire_age_months": 0
          }
        }
      }
    },
    {
