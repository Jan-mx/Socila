{
  "rule_id": "R-GD-UI-AMOUNT",
  "name": "广东失业保险金月标准（按失业保险金领取地市最低工资×90%）",
  "module": "unemployment",
  "dsl_version": "SOCILA-DSL-1.0",
  "priority": 430,
  "effective_from": "2025-01-12",
  "effective_to": null,
  "supersedes": [],
  "operation": "add",
  "target_business_key": null,
  "status": "published",
  "inputs": [
    {
      "key": "calc.unemployment.eligible",
      "type": "boolean",
      "required": true,
      "desc": "失业资格结论（R-400输出）；false/未知时不估算金额"
    },
    {
      "key": "user.profile.claim_city",
      "type": "string",
      "required": false,
      "desc": "失业保险金领取地市（广东省条例第十九条：按领取地地级以上市最低工资标准计发；由用户确认后传递，系统不猜测）"
    },
    {
      "key": "params.T-GD-MIN-WAGE-BY-CITY",
      "type": "table",
      "required": true,
      "desc": "广东省最低工资分市表（粤府函〔2026〕188号，2026-09-01起）"
    },
    {
      "key": "params.P-GD-UNEMPLOYMENT-BENEFIT-RATE",
      "type": "number",
      "required": true,
      "desc": "失业保险金计发比例90%（广东省失业保险条例第十九条）"
    }
  ],
  "parameter_refs": [
    {
      "param_id": "T-GD-MIN-WAGE-BY-CITY",
      "purpose": "失业保险金领取地市最低工资（分市表，2026-09-01起）"
    },
    {
      "param_id": "P-GD-UNEMPLOYMENT-BENEFIT-RATE",
      "purpose": "失业保险金计发比例90%（条例第十九条）"
    }
  ],
  "outputs": [
    {
      "key": "calc.unemployment.monthly_amount_est",
      "type": "number"
    },
    {
      "key": "calc.needs_agent",
      "type": "boolean"
    },
    {
      "key": "calc.warnings",
      "type": "array"
    },
    {
      "key": "calc.agent_questions",
      "type": "array"
    }
  ],
  "decision_table": {
    "hit_policy": "all",
    "rows": [
      {
        "row_id": "row_1_not_eligible",
        "when": {
          "==": [
            {
              "var": "calc.unemployment.eligible"
            },
            false
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.unemployment.monthly_amount_est",
              "value": 0
            }
          ]
        }
      },
      {
        "row_id": "row_2_unknown",
        "when": {
          "==": [
            {
              "var": "calc.unemployment.eligible"
            },
            null
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.unemployment.monthly_amount_est",
              "value": null
            }
          ]
        }
      },
      {
        "row_id": "row_3_missing_city",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "calc.unemployment.eligible"
                },
                true
              ]
            },
            {
              "==": [
                {
                  "var": "user.profile.claim_city"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_question",
              "value": {
                "question_id": "Q-UI-CLAIM-CITY",
                "text": "请确认失业保险金领取地市（用于按领取地市最低工资标准核算失业金金额）。",
                "field": "user.profile.claim_city"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_4_lookup_wage",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "calc.unemployment.eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "user.profile.claim_city"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "lookup",
              "table_param_id": "T-GD-MIN-WAGE-BY-CITY",
              "key": {
                "city": {
                  "var": "user.profile.claim_city"
                }
              },
              "into": "calc.unemployment._min_wage_row",
              "into_map": {
                "monthly": "calc.unemployment._min_wage_monthly",
                "tier": "calc.unemployment._min_wage_tier"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_5_wage_missing",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "calc.unemployment.eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "user.profile.claim_city"
                },
                null
              ]
            },
            {
              "==": [
                {
                  "var": "calc.unemployment._min_wage_monthly"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_warning",
              "value": {
                "warning_id": "W-UI-MIN-WAGE-MISSING",
                "text": "领取地市不在当前最低工资表中或最低工资缺失，无法核算失业保险金金额，需人工确认领取地市。"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_6_compute",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "calc.unemployment.eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "user.profile.claim_city"
                },
                null
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.unemployment._min_wage_monthly"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.unemployment.monthly_amount_est",
              "value": {
                "*": [
                  {
                    "var": "calc.unemployment._min_wage_monthly"
                  },
                  {
                    "var": "params.P-GD-UNEMPLOYMENT-BENEFIT-RATE"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "examples": [
    {
      "input": {
        "user": {
          "profile": {
            "claim_city": "广州"
          },
          "status": {
            "employment_status": "unemployed"
          },
          "social": {
            "unemployment_insurance_years": 3
          }
        },
        "calc": {
          "unemployment": {
            "eligible": true
          }
        }
      },
      "expected": {
        "calc": {
          "unemployment": {
            "monthly_amount_est": 2412
          }
        }
      },
      "name": "广州领取：2680元/月最低工资×90%＝2412元/月"
    },
    {
      "input": {
        "user": {
          "status": {
            "employment_status": "unemployed"
          }
        },
        "calc": {
          "unemployment": {
            "eligible": true
          }
        }
      },
      "expected": {
        "calc": {
          "needs_agent": true
        }
      },
      "name": "领取地市缺失：不猜测金额，转入人工确认"
    },
    {
      "input": {
        "user": {
          "profile": {
            "claim_city": "未收录市"
          },
          "status": {
            "employment_status": "unemployed"
          }
        },
        "calc": {
          "unemployment": {
            "eligible": true
          }
        }
      },
      "expected": {
        "calc": {
          "needs_agent": true,
          "warnings": [
            {
              "warning_id": "W-UI-MIN-WAGE-MISSING"
            }
          ]
        }
      },
      "name": "领取地市不在最低工资表：needs_agent且金额为空"
    },
    {
      "input": {
        "user": {
          "profile": {
            "claim_city": "广州"
          },
          "status": {
            "employment_status": "employed"
          }
        },
        "calc": {
          "unemployment": {
            "eligible": false
          }
        }
      },
      "expected": {
        "calc": {
          "unemployment": {
            "monthly_amount_est": 0
          }
        }
      },
      "name": "失业资格不满足：金额为0"
    }
  ],
  "evidence": [
    {
      "document_id": "DOC-GD-UNEMPLOYMENT-REGULATION",
      "jurisdiction_code": "440000",
      "title": "广东省失业保险条例（2002年通过、2013年修订、2022年第一次修正、2025年1月12日第二次修正）",
      "authority": "广东省人民代表大会常务委员会",
      "official_url": "https://hrss.gd.gov.cn/gkmlpt/content/4/4669/post_4669825.html",
      "fetched_at": "2026-09-06T14:07:25.406Z",
      "content_sha256": "15f3551f796ae24058b996c75d5220a79115dc9a82915cbff537b008d28e4456",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/GD/DOC-GD-UNEMPLOYMENT-REGULATION/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "body",
        "reference": "第十九条"
      },
      "excerpt": "第十九条 失业保险金由社会保险经办机构按照失业保险金领取地地级以上市最低工资标准的百分之九十按月计发，省人民政府根据国家规定可以适当调整失业保险金标准。"
    },
    {
      "document_id": "DOC-GD-MINIMUM-WAGE-2026",
      "jurisdiction_code": "440000",
      "title": "广东省人民政府关于调整我省最低工资标准的通知（粤府函〔2026〕188号）",
      "authority": "广东省人民政府",
      "official_url": "https://www.gd.gov.cn/zwgk/wjk/qbwj/yfh/content/post_4942177.html",
      "fetched_at": "2026-09-07T02:13:46.755Z",
      "content_sha256": "de716e1c054d4fb232a9579985d0a83a40d240a3f35b859a933cf14cb2bc7513",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/GD/DOC-GD-MINIMUM-WAGE-2026/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "body",
        "reference": "正文第一条及附件《广东省最低工资标准表》"
      },
      "excerpt": "从2026年9月1日起，对我省全日制就业劳动者月最低工资标准和非全日制小时最低工资标准进行调整，具体标准附后。"
    }
  ],
  "notes": "广东省失业保险条例第十九条：失业保险金按领取地地级以上市最低工资标准的90%按月计发。领取地市或最低工资缺失时输出needs_agent且不估算金额（任务2首期实现；领取地市由任务3确认后传递，本规则不猜测）。"
}
