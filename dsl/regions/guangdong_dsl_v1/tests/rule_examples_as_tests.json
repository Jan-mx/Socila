{
  "tests": [
    {
      "rule_id": "R-220-MEDICAL-LIFETIME-GAP",
      "example_name": "广东2030口径：男性已缴120月按30年 -> 缺240月",
      "input": {
        "user": {
          "basic": { "gender": "male" },
          "social": { "medical_contrib_months": 120 }
        },
        "params": { "P-MI-LIFETIME-MALE-YEARS": 30 }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "mi": {
            "lifetime_required_months": 360,
            "lifetime_gap_months": 240
          }
        }
      }
    },
    {
      "rule_id": "R-220-MEDICAL-LIFETIME-GAP",
      "example_name": "广东2030口径：女性已缴120月按25年 -> 缺180月",
      "input": {
        "user": {
          "basic": { "gender": "female" },
          "social": { "medical_contrib_months": 120 }
        },
        "params": { "P-MI-LIFETIME-FEMALE-YEARS": 25 }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "mi": {
            "lifetime_required_months": 300,
            "lifetime_gap_months": 180
          }
        }
      }
    },
    {
      "rule_id": "R-110-LOOKUP-LEGAL-RETIRE-AGE",
      "example_name": "广东继承国家口径：1965-01男 -> 60岁1个月",
      "input": {
        "user": {
          "basic": {
            "gender": "male",
            "female_retire_type": "na",
            "birth_year": 1965,
            "birth_month": 1,
            "birth_date": "1965-01-15"
          }
        }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "retirement": {
            "legal_retire_age_years": 60,
            "legal_retire_age_months": 1,
            "original_retire_age_years": 60
          }
        }
      }
    },
    {
      "rule_id": "R-410-UNEMPLOYMENT-DURATION",
      "example_name": "广东继承国家法定档：失业险6年 -> 最长18个月",
      "input": {
        "calc": { "unemployment": { "eligible": true } },
        "user": { "social": { "unemployment_insurance_years": 6 } },
        "params": {
          "P-UNEMPLOYMENT-MAX-MONTHS": 24,
          "T-UNEMPLOYMENT-DURATION-BY-YEARS": [
            { "insured_years_min": 1, "insured_years_max": 5, "months": 12 },
            { "insured_years_min": 5, "insured_years_max": 10, "months": 18 },
            { "insured_years_min": 10, "insured_years_max": 99, "months": 24 }
          ]
        }
      },
      "params_override": null,
      "expected": {
        "calc": { "unemployment": { "duration_months": 18 } }
      }
    },
    {
      "rule_id": "R-200-MIN-PENSION-YEARS",
      "example_name": "广东继承国家时间线：退休年份2033 -> 17年",
      "input": {
        "calc": { "retirement": { "legal_retire_year": 2033 } }
      },
      "params_override": null,
      "expected": {
        "calc": { "pension": { "min_years_required": 17 } }
      }
    }
  ]
}
