{
  "dsl_version": "SOCILA-DSL-1.0",
  "rule_id": "R-900-FINAL-GATE",
  "name": "最终Gate：关键字段缺失/冲突 -> needs_agent",
  "module": "gate",
  "status": "published",
  "priority": 900,
  "effective_from": "2024-01-01",
  "effective_to": null,
  "supersedes": [],
  "notes": "该 Gate 主要保证系统不会在关键字段缺失时输出“伪结论”。",
  "inputs": [
    {
      "key": "user.basic.gender",
      "type": "string",
      "required": true
    },
    {
      "key": "user.basic.birth_year",
      "type": "number",
      "required": true
    },
    {
      "key": "user.status.employment_status",
      "type": "string",
      "required": true
    }
  ],
  "parameter_refs": [],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_any_missing",
        "when": {
          "or": [
            {
              "==": [
                {
                  "var": "user.basic.gender"
                },
                null
              ]
            },
            {
              "==": [
                {
                  "var": "user.basic.birth_year"
                },
                null
              ]
            },
            {
              "==": [
                {
                  "var": "user.status.employment_status"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_question",
              "value": {
                "question_id": "Q-CORE",
                "text": "缺少核心信息（性别/出生年份/当前状态），无法生成可执行规划。请补齐。"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_2_ok",
        "when": {},
        "then": {
          "actions": []
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "calc.needs_agent",
      "type": "boolean"
    },
    {
      "key": "calc.agent_questions",
      "type": "array"
    }
  ],
  "examples": [
    {
      "name": "缺出生年份 -> needs_agent",
      "input": {
        "user": {
          "basic": {
            "gender": "male",
            "birth_year": null
          },
          "status": {
            "employment_status": "employed"
          }
        }
      },
      "expected": {
        "calc": {
          "needs_agent": true
        }
      }
    }
  ],
  "evidence": []
}