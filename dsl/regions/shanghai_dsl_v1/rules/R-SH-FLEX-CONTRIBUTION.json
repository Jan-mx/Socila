      "authority": "上海市人力资源和社会保障局",
      "official_url": "https://rsj.sh.gov.cn/tdjjf_17554/20200918/t0035_1393992.html",
      "fetched_at": "2026-09-11T03:40:01.131Z",
      "content_sha256": "297352d22d52e1a9babf4218abc751dd363177dfa7ad947124f6e7363bc39e8a",
