{
  "dsl_version": "SOCILA-DSL-1.0",
  "rule_id": "R-510-4050-AMOUNT",
  "name": "4050补贴金额估算（基数下限 * 缴费比例 * 补贴比例）",
  "module": "subsidy",
  "status": "published",
  "priority": 510,
  "effective_from": "2024-01-01",
  "effective_to": null,
  "supersedes": [],
  "notes": "此为估算。实际4050补贴通常按“基数下限对应缴费额的50%”口径发放，且仅覆盖指定险种；以经办为准。",
  "inputs": [
    {
      "key": "calc.subsidy.4050_eligible",
      "type": "boolean",
      "required": true
    },
    {
      "key": "user.social.base_lower_amount_per_month",
      "type": "number",
      "required": false,
      "desc": "缴费基数下限（月）"
    },
    {
      "key": "params.P-SH-PENSION-RATE-FLEX",
      "type": "number",
      "required": true
    },
    {
      "key": "params.P-SH-MEDICAL-RATE-FLEX",
      "type": "number",
      "required": true
    },
    {
      "key": "params.P-SH-4050-SUBSIDY-RATE",
      "type": "number",
      "required": true
    }
  ],
  "parameter_refs": [
    {
      "param_id": "P-SH-PENSION-RATE-FLEX"
    },
    {
      "param_id": "P-SH-MEDICAL-RATE-FLEX"
    },
    {
      "param_id": "P-SH-4050-SUBSIDY-RATE"
    }
  ],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_not_eligible",
        "when": {
          "or": [
            {
              "==": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                false
              ]
            },
            {
              "==": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.4050_amount_est",
              "value": 0
            }
          ]
        }
      },
      {
        "row_id": "row_2_missing_base",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                true
              ]
            },
            {
              "==": [
                {
                  "var": "user.social.base_lower_amount_per_month"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.4050_amount_est",
              "value": null
            },
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_question",
              "value": {
                "question_id": "Q-BASE-LOWER",
                "text": "请提供当前缴费基数下限（或选择“按下限缴费”），用于估算4050补贴金额。",
                "field": "user.social.base_lower_amount_per_month"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_3_compute",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "user.social.base_lower_amount_per_month"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.flex_cost_est",
              "value": {
                "*": [
                  {
                    "var": "user.social.base_lower_amount_per_month"
                  },
                  {
                    "+": [
                      {
                        "var": "params.P-SH-PENSION-RATE-FLEX"
                      },
                      {
                        "var": "params.P-SH-MEDICAL-RATE-FLEX"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "set",
              "path": "calc.subsidy.4050_amount_est",
              "value": {
                "*": [
                  {
                    "var": "calc.subsidy.flex_cost_est"
                  },
                  {
                    "var": "params.P-SH-4050-SUBSIDY-RATE"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "calc.subsidy.4050_amount_est",
      "type": "number"
    },
    {
      "key": "calc.subsidy.flex_cost_est",
      "type": "number"
    },
    {
      "key": "calc.needs_agent",
      "type": "boolean"
    },
    {
      "key": "calc.agent_questions",
      "type": "array"
    }
  ],
  "examples": [
    {
      "name": "下限基数5000，比例0.3，补贴50% -> 750",
      "input": {
        "calc": {
          "subsidy": {
            "4050_eligible": true
          }
        },
        "user": {
          "social": {
            "base_lower_amount_per_month": 5000
          }
        },
        "params": {
          "P-SH-PENSION-RATE-FLEX": 0.2,
          "P-SH-MEDICAL-RATE-FLEX": 0.1,
          "P-SH-4050-SUBSIDY-RATE": 0.5
        }
      },
      "expected": {
        "calc": {
          "subsidy": {
            "flex_cost_est": 1500,
            "4050_amount_est": 750
          }
        }
      }
    }
  ],
  "evidence": []
}