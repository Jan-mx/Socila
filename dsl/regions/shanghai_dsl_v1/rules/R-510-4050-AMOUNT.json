{
  "dsl_version": "SOCILA-DSL-1.0",
  "rule_id": "R-510-4050-AMOUNT",
  "name": "4050灵活就业社保补贴金额估算（下限基数应缴社会保险费×补贴比例）",
  "module": "subsidy",
  "status": "published",
  "priority": 510,
  "effective_from": "2024-01-01",
  "effective_to": null,
  "supersedes": [],
  "notes": "估算口径：以缴费当月职工社会保险缴费基数的下限作为缴费基数计算的应缴社会保险费的50%（沪人社规〔2022〕8号三）；仅覆盖指定险种，以经办为准。",
  "inputs": [
    {
      "key": "calc.subsidy.4050_eligible",
      "type": "boolean",
      "required": true
    }
  ],
  "parameter_refs": [
    {
      "param_id": "P-SH-CONTRIB-BASE-LOWER",
      "purpose": "当期缴费基数下限（元/月）"
    },
    {
      "param_id": "P-SH-PENSION-RATE-FLEX",
      "purpose": "灵活就业养老保险费率"
    },
    {
      "param_id": "P-SH-MEDICAL-RATE-FLEX",
      "purpose": "灵活就业医疗保险费率"
    },
    {
      "param_id": "P-SH-4050-SUBSIDY-RATE",
      "purpose": "补贴比例（应缴社会保险费的50%）"
    }
  ],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_not_eligible",
        "when": {
          "or": [
            {
              "==": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                false
              ]
            },
            {
              "==": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.4050_amount_est",
              "value": 0
            }
          ]
        }
      },
      {
        "row_id": "row_2_params_missing",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                true
              ]
            },
            {
              "or": [
                {
                  "==": [
                    {
                      "var": "params.P-SH-CONTRIB-BASE-LOWER"
                    },
                    null
                  ]
                },
                {
                  "==": [
                    {
                      "var": "params.P-SH-PENSION-RATE-FLEX"
                    },
                    null
                  ]
                },
                {
                  "==": [
                    {
                      "var": "params.P-SH-MEDICAL-RATE-FLEX"
                    },
                    null
                  ]
                },
                {
                  "==": [
                    {
                      "var": "params.P-SH-4050-SUBSIDY-RATE"
                    },
                    null
                  ]
                }
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.4050_amount_est",
              "value": null
            },
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_warning",
              "value": {
                "warning_id": "W-SUBSIDY-PARAM-MISSING",
                "text": "缺少有效缴费基数下限、灵活就业费率或补贴比例参数，无法估算补贴金额。"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_3_compute",
        "when": {
          "==": [
            {
              "var": "calc.subsidy.4050_eligible"
            },
            true
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.flex_cost_est",
              "value": {
                "/": [
                  {
                    "floor": [
                      {
                        "+": [
                          {
                            "*": [
                              {
                                "*": [
                                  {
                                    "var": "params.P-SH-CONTRIB-BASE-LOWER"
                                  },
                                  {
                                    "+": [
                                      {
                                        "var": "params.P-SH-PENSION-RATE-FLEX"
                                      },
                                      {
                                        "var": "params.P-SH-MEDICAL-RATE-FLEX"
                                      }
                                    ]
                                  }
                                ]
                              },
                              100
                            ]
                          },
                          0.5
                        ]
                      }
                    ]
                  },
                  100
                ]
              }
            },
            {
              "type": "set",
              "path": "calc.subsidy.4050_amount_est",
              "value": {
                "/": [
                  {
                    "floor": [
                      {
                        "+": [
                          {
                            "*": [
                              {
                                "*": [
                                  {
                                    "var": "calc.subsidy.flex_cost_est"
                                  },
                                  {
                                    "var": "params.P-SH-4050-SUBSIDY-RATE"
                                  }
                                ]
                              },
                              100
                            ]
                          },
                          0.5
                        ]
                      }
                    ]
                  },
                  100
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "calc.subsidy.4050_amount_est",
      "type": "number"
    },
    {
      "key": "calc.subsidy.flex_cost_est",
      "type": "number"
    },
    {
      "key": "calc.needs_agent",
      "type": "boolean"
    },
    {
      "key": "calc.warnings",
      "type": "array"
    }
  ],
  "examples": [
    {
      "name": "下限基数7546、费率0.3、补贴50% -> 1131.9",
      "input": {
        "calc": {
          "subsidy": {
            "4050_eligible": true
          }
        },
        "params": {
          "P-SH-CONTRIB-BASE-LOWER": 7546,
          "P-SH-PENSION-RATE-FLEX": 0.2,
          "P-SH-MEDICAL-RATE-FLEX": 0.1,
          "P-SH-4050-SUBSIDY-RATE": 0.5
        }
      },
      "expected": {
        "calc": {
          "subsidy": {
            "flex_cost_est": 2263.8,
            "4050_amount_est": 1131.9
          }
        }
      }
    }
  ],
  "evidence": [
    {
      "document_id": "DOC-SH-EMPLOYMENT-ASSISTANCE-2022",
      "jurisdiction_code": "310000",
      "title": "关于进一步做好本市就业援助工作的若干意见（沪人社规〔2022〕8号）",
      "authority": "上海市人力资源和社会保障局 上海市财政局 上海市民政局 上海市残疾人联合会",
      "official_url": "https://rsj.sh.gov.cn/tjypx_17728/20220311/t0035_1406349.html",
      "fetched_at": "2026-09-11T04:01:44.294Z",
      "content_sha256": "c926b5086af8fa4217b388e613d3f569e49081457b01513e236fcd16278e55cd",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/310000/DOC-SH-EMPLOYMENT-ASSISTANCE-2022/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "paragraph",
        "reference": "三"
      },
      "excerpt": "补贴标准为按照以缴费当月职工社会保险缴费基数的下限作为缴费基数计算的应缴社会保险费的50%，补贴期限除对距法定退休年龄不足5年的可延长至退休外，同一名“就业困难人员”累计最长不超过3年。"
    },
    {
      "document_id": "DOC-SH-FLEX-SUBSIDY-STANDARD-2022",
