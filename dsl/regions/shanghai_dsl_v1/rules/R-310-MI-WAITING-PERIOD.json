{
  "dsl_version": "SOCILA-DSL-1.0",
  "rule_id": "R-310-MI-WAITING-PERIOD",
  "name": "医保等待期判定（断缴>阈值 -> 等待期）",
  "module": "medical_insurance",
  "status": "published",
  "priority": 310,
  "effective_from": "2025-09-10",
  "effective_to": "2030-09-09",
  "supersedes": [],
  "notes": "等待期6个月与中断不超过3个月豁免出自沪医保规〔2025〕7号（三（四））；原沪人社医发〔2012〕45号同时废止。",
  "inputs": [
    {
      "key": "calc.mi.gap_months",
      "type": "number",
      "required": false
    },
    {
      "key": "params.P-SH-MI-GAP-WAIVER-MONTHS",
      "type": "number",
      "required": true
    },
    {
      "key": "params.P-SH-MI-WAITING-PERIOD-MONTHS",
      "type": "number",
      "required": true
    }
  ],
  "parameter_refs": [
    {
      "param_id": "P-SH-MI-GAP-WAIVER-MONTHS",
      "purpose": "医保衔接免等待期阈值（月）"
    },
    {
      "param_id": "P-SH-MI-WAITING-PERIOD-MONTHS",
      "purpose": "灵活就业医保等待期（月）"
    }
  ],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_gap_unknown",
        "when": {
          "==": [
            {
              "var": "calc.mi.gap_months"
            },
            null
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.mi.waiting_period_months",
              "value": null
            },
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_question",
              "value": {
                "question_id": "Q-MI-GAP",
                "text": "无法判断医保断缴月数，可能影响等待期。请补充上次医保结束日期。",
                "field": "user.mi.prev_end_date"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_2_no_waiting",
        "when": {
          "<=": [
            {
              "var": "calc.mi.gap_months"
            },
            {
              "var": "params.P-SH-MI-GAP-WAIVER-MONTHS"
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.mi.waiting_period_months",
              "value": 0
            },
            {
              "type": "set",
              "path": "calc.mi.waiting_required",
              "value": false
            }
          ]
        }
      },
      {
        "row_id": "row_3_need_waiting",
        "when": {
          ">": [
            {
              "var": "calc.mi.gap_months"
            },
            {
              "var": "params.P-SH-MI-GAP-WAIVER-MONTHS"
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.mi.waiting_period_months",
              "value": {
                "var": "params.P-SH-MI-WAITING-PERIOD-MONTHS"
              }
            },
            {
              "type": "set",
              "path": "calc.mi.waiting_required",
              "value": true
            },
            {
              "type": "emit_warning",
              "value": {
                "warning_id": "W-MI-WAITING",
                "text": "医保断缴超过阈值，可能触发等待期；规划中需优先保证医保连续性。"
              }
            }
          ]
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "calc.mi.waiting_period_months",
      "type": "number"
    },
    {
      "key": "calc.mi.waiting_required",
      "type": "boolean"
    },
    {
      "key": "calc.warnings",
      "type": "array"
    },
    {
      "key": "calc.needs_agent",
      "type": "boolean"
    },
    {
      "key": "calc.agent_questions",
      "type": "array"
    }
  ],
  "examples": [
    {
      "name": "断缴2个月 <=3 -> 0等待期",
      "input": {
        "calc": {
          "mi": {
            "gap_months": 2
          }
        },
        "params": {
          "P-SH-MI-GAP-WAIVER-MONTHS": 3,
          "P-SH-MI-WAITING-PERIOD-MONTHS": 6
        }
      },
      "expected": {
        "calc": {
          "mi": {
            "waiting_period_months": 0,
            "waiting_required": false
          }
        }
      }
    },
    {
      "name": "断缴5个月 -> 6个月等待期",
      "input": {
        "calc": {
          "mi": {
            "gap_months": 5
          }
        },
        "params": {
          "P-SH-MI-GAP-WAIVER-MONTHS": 3,
          "P-SH-MI-WAITING-PERIOD-MONTHS": 6
        }
      },
      "expected": {
        "calc": {
          "mi": {
            "waiting_period_months": 6,
            "waiting_required": true
          }
        }
      }
    }
  ],
  "evidence": [
    {
      "document_id": "DOC-SH-MI-FLEX-WAITING-2025",
      "jurisdiction_code": "310000",
      "title": "上海市职工基本医疗保险办法实施细则（沪医保规〔2025〕7号）",
      "authority": "上海市医疗保障局",
      "official_url": "https://ybj.sh.gov.cn/gfxwj/20250905/6173c838284f43c3b4d8c8d4513364ed.html",
      "fetched_at": "2026-09-11T03:40:06.660Z",
      "content_sha256": "549493856745e71c69843e87abceaa722583f9829c630ae616fda6d28260e587",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/310000/DOC-SH-MI-FLEX-WAITING-2025/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "paragraph",
        "reference": "三（四）"
      },
      "excerpt": "参加本市职工医保的灵活就业人员，享受医疗保险待遇的等待期为6个月。"
    },
    {
      "document_id": "DOC-SH-MI-FLEX-WAITING-2025",
      "jurisdiction_code": "310000",
      "title": "上海市职工基本医疗保险办法实施细则（沪医保规〔2025〕7号）",
      "authority": "上海市医疗保障局",
      "official_url": "https://ybj.sh.gov.cn/gfxwj/20250905/6173c838284f43c3b4d8c8d4513364ed.html",
      "fetched_at": "2026-09-11T03:40:06.660Z",
      "content_sha256": "549493856745e71c69843e87abceaa722583f9829c630ae616fda6d28260e587",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/310000/DOC-SH-MI-FLEX-WAITING-2025/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "paragraph",
        "reference": "三（四）末段"
      },
      "excerpt": "在中断享受职工医保待遇或城乡居民医保待遇后的3个月内以灵活就业人员身份参加职工医保并按规定缴费的，不受待遇等待期规定限制。"
    }
  ],
  "operation": "add"
}
