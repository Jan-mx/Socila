{
  "dsl_version": "SOCILA-DSL-1.0",
  "rule_id": "R-530-OLDER-UI-PENSION-FUND-COVERAGE",
  "name": "大龄领失业金人员养老最低档由基金承担（资格初判）",
  "module": "subsidy",
  "status": "published",
  "priority": 530,
  "effective_from": "2024-01-01",
  "effective_to": null,
  "supersedes": [],
  "notes": "机制与口径出自上海市人社局官方问答（2025-01-20）：按灵活就业最低缴费标准部分由失业保险基金支付，距法定退休年龄不足1年内实际缴纳月数在退休后一次性支付。",
  "inputs": [
    {
      "key": "user.status.on_unemployment_benefit",
      "type": "boolean",
      "required": false
    },
    {
      "key": "user.subsidy.months_to_legal_retire",
      "type": "number",
      "required": false
    }
  ],
  "parameter_refs": [],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_missing_months",
        "when": {
          "==": [
            {
              "var": "user.subsidy.months_to_legal_retire"
            },
            null
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.older_ui_pension_fund_eligible",
              "value": null
            },
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_question",
              "value": {
                "question_id": "Q-MONTHS-TO-RETIRE",
                "text": "缺少距退休月数，无法判断是否处于“距法定退休年龄不足1年”的大龄窗口。",
                "field": "user.subsidy.months_to_legal_retire"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_2_not_on_ui",
        "when": {
          "or": [
            {
              "==": [
                {
                  "var": "user.status.on_unemployment_benefit"
                },
                false
              ]
            },
            {
              "==": [
                {
                  "var": "user.status.on_unemployment_benefit"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.older_ui_pension_fund_eligible",
              "value": false
            }
          ]
        }
      },
      {
        "row_id": "row_3_eligible",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "user.status.on_unemployment_benefit"
                },
                true
              ]
            },
            {
              "<=": [
                {
                  "var": "user.subsidy.months_to_legal_retire"
                },
                12
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.older_ui_pension_fund_eligible",
              "value": true
            },
            {
              "type": "emit_warning",
              "value": {
                "warning_id": "W-OLDER-UI-PENSION",
                "text": "符合大龄条件时，在本市以个人身份参加企业职工基本养老保险并缴费，其中按灵活就业人员最低缴费标准的部分由失业保险基金支付；须达到法定退休年龄次月起申请，按距退休不足1年内实际缴纳月数一次性支付。"
              }
            }
          ]
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "calc.subsidy.older_ui_pension_fund_eligible",
      "type": "boolean"
    },
    {
      "key": "calc.warnings",
      "type": "array"
    },
    {
      "key": "calc.needs_agent",
      "type": "boolean"
    }
  ],
  "examples": [
    {
      "name": "领失业金且距退休10个月 -> eligible",
      "input": {
        "user": {
          "status": {
            "on_unemployment_benefit": true
          },
          "subsidy": {
            "months_to_legal_retire": 10
          }
        }
      },
      "expected": {
        "calc": {
          "subsidy": {
            "older_ui_pension_fund_eligible": true
          }
        }
      }
    }
  ],
  "evidence": [
    {
      "document_id": "DOC-SH-UI-OLDER-PENSION-STANDARD-2025",
      "jurisdiction_code": "310000",
      "title": "大龄领取失业保险金人员参加企业职工基本养老保险的补贴标准是什么？（上海市人力资源和社会保障局）",
      "authority": "上海市人力资源和社会保障局",
      "official_url": "https://rsj.sh.gov.cn/tlqtj_17563/20250120/t0035_1430066.html",
      "fetched_at": "2026-09-11T03:58:15.406Z",
      "content_sha256": "14c31397b23efc63acec377d6503bd95ddaea226c6a6bfa620a0435f9c3bf1ba",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/310000/DOC-SH-UI-OLDER-PENSION-STANDARD-2025/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "body",
        "reference": "答"
      },
      "excerpt": "大龄领取失业保险金人员在本市以个人身份参加企业职工基本养老保险并缴费，其中按本市灵活就业人员最低缴费标准的部分由失业保险基金支付。"
    },
    {
      "document_id": "DOC-SH-UI-OLDER-PENSION-APPLY-2025",
      "jurisdiction_code": "310000",
      "title": "大龄领取失业保险金人员如何申领由失业保险基金承担的养老保险费用？（上海市人力资源和社会保障局）",
      "authority": "上海市人力资源和社会保障局",
      "official_url": "https://rsj.sh.gov.cn/tlqtj_17563/20250120/t0035_1430067.html",
      "fetched_at": "2026-09-11T03:58:20.289Z",
      "content_sha256": "4c95b372865d91ceb1bcf494a9cc67f8d4e48f953a254488f1b85ef9fbcd282a",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/310000/DOC-SH-UI-OLDER-PENSION-APPLY-2025/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "body",
        "reference": "答"
      },
      "excerpt": "经办机构审核后按照个人距离法定退休年龄不足1年内实际缴纳月数一次性支付。"
    },
    {
      "document_id": "DOC-SH-UI-OLDER-PENSION-FUND-2025",
      "jurisdiction_code": "310000",
      "title": "在本市领取失业保险金的大龄人员在外省市参加企业职工基本养老保险，可否申领由失业保险基金承担的费用？（上海市人力资源和社会保障局）",
      "authority": "上海市人力资源和社会保障局",
      "official_url": "https://rsj.sh.gov.cn/tlqtj_17563/20250120/t0035_1430068.html",
      "fetched_at": "2026-09-11T03:56:18.320Z",
      "content_sha256": "8285e470654ea89f239099c38204a4bf2432bafaf2c69edb9350069ba1cc7ef9",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/310000/DOC-SH-UI-OLDER-PENSION-FUND-2025/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "body",
        "reference": "答"
      },
      "excerpt": "在本市领取失业保险金的大龄人员应参加本市企业职工基本养老保险，才可以在本市申领由失业保险基金承担的费用。"
    }
  ],
  "operation": "add"
}
