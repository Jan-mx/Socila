{
  "dsl_version": "SOCILA-DSL-1.0",
  "rule_id": "R-540-SUBSIDY-MUTUAL-EXCLUSION",
  "name": "补贴/基金承担互斥与选择（4050 vs 岗位补贴 vs 大龄领金养老费承担）",
  "module": "subsidy",
  "status": "published",
  "priority": 540,
  "effective_from": "2024-01-01",
  "effective_to": null,
  "supersedes": [],
  "notes": "大龄领金人员参加企业职工基本养老保险期间不可同时享受灵活就业社保补贴及岗位补贴（官方问答2025-01-20）；补贴期满的就业困难人员身份取消（沪人社规〔2022〕8号）。",
  "inputs": [
    {
      "key": "calc.subsidy.4050_eligible",
      "type": "boolean",
      "required": false
    },
    {
      "key": "calc.subsidy.job_eligible",
      "type": "boolean",
      "required": false
    },
    {
      "key": "calc.subsidy.older_ui_pension_fund_eligible",
      "type": "boolean",
      "required": false
    },
    {
      "key": "calc.subsidy.4050_amount_est",
      "type": "number",
      "required": false
    },
    {
      "key": "calc.subsidy.job_amount_est",
      "type": "number",
      "required": false
    },
    {
      "key": "user.objective",
      "type": "string",
      "required": false
    }
  ],
  "parameter_refs": [],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_only_4050",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.subsidy.job_eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.subsidy.older_ui_pension_fund_eligible"
                },
                true
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.selected_option",
              "value": "4050"
            }
          ]
        }
      },
      {
        "row_id": "row_2_only_job",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "calc.subsidy.job_eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.subsidy.older_ui_pension_fund_eligible"
                },
                true
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.selected_option",
              "value": "job_subsidy"
            }
          ]
        }
      },
      {
        "row_id": "row_3_only_older_ui",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "calc.subsidy.older_ui_pension_fund_eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.subsidy.job_eligible"
                },
                true
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.selected_option",
              "value": "older_ui_pension_fund"
            }
          ]
        }
      },
      {
        "row_id": "row_4_none",
        "when": {
          "and": [
            {
              "!=": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.subsidy.job_eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.subsidy.older_ui_pension_fund_eligible"
                },
                true
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.selected_option",
              "value": "none"
            }
          ]
        }
      },
      {
        "row_id": "row_5_conflict_min_cost_choose_job",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "user.objective"
                },
                "min_cost"
              ]
            },
            {
              "==": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                true
              ]
            },
            {
              "==": [
                {
                  "var": "calc.subsidy.job_eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.subsidy.4050_amount_est"
                },
                null
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.subsidy.job_amount_est"
                },
                null
              ]
            },
            {
              ">": [
                {
                  "var": "calc.subsidy.job_amount_est"
                },
                {
                  "var": "calc.subsidy.4050_amount_est"
                }
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.selected_option",
              "value": "job_subsidy"
            },
            {
              "type": "emit_warning",
              "value": {
                "warning_id": "W-SUBSIDY-CHOICE",
                "text": "同时符合4050与岗位补贴窗口，按“最低净成本”目标选择补贴金额更高的岗位补贴（估算）。请以经办互斥口径确认。"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_6_conflict_min_cost_choose_4050",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "user.objective"
                },
                "min_cost"
              ]
            },
            {
              "==": [
                {
                  "var": "calc.subsidy.4050_eligible"
                },
                true
              ]
            },
            {
              "==": [
                {
                  "var": "calc.subsidy.job_eligible"
                },
                true
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.subsidy.4050_amount_est"
                },
                null
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.subsidy.job_amount_est"
                },
                null
              ]
            },
            {
              "<=": [
                {
                  "var": "calc.subsidy.job_amount_est"
                },
                {
                  "var": "calc.subsidy.4050_amount_est"
                }
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.selected_option",
              "value": "4050"
            },
            {
              "type": "emit_warning",
              "value": {
                "warning_id": "W-SUBSIDY-CHOICE",
                "text": "同时符合4050与岗位补贴窗口，按“最低净成本”目标选择补贴金额更高/相当的4050（估算）。请以经办互斥口径确认。"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_7_conflict_need_agent",
        "when": {
          "or": [
            {
              "and": [
                {
                  "==": [
                    {
                      "var": "calc.subsidy.4050_eligible"
                    },
                    true
                  ]
                },
                {
                  "==": [
                    {
                      "var": "calc.subsidy.job_eligible"
                    },
                    true
                  ]
                }
              ]
            },
            {
              "and": [
                {
                  "==": [
                    {
                      "var": "calc.subsidy.4050_eligible"
                    },
                    true
                  ]
                },
                {
                  "==": [
                    {
                      "var": "calc.subsidy.older_ui_pension_fund_eligible"
                    },
                    true
                  ]
                }
              ]
            },
            {
              "and": [
                {
                  "==": [
                    {
                      "var": "calc.subsidy.job_eligible"
                    },
                    true
                  ]
                },
                {
                  "==": [
                    {
                      "var": "calc.subsidy.older_ui_pension_fund_eligible"
                    },
                    true
                  ]
                }
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.selected_option",
              "value": "conflict"
            },
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_question",
              "value": {
                "question_id": "Q-SUBSIDY-CONFLICT",
                "text": "你可能同时落入多个补贴/基金承担窗口（例如4050与岗位补贴互斥）。请确认你的目标（省钱/多缴/医保连续性）并补充：基数下限、最低工资、是否已领失业金等，以便对比方案。",
                "field": "user.objective"
              }
            }
          ]
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "calc.subsidy.selected_option",
      "type": "string"
    },
    {
      "key": "calc.needs_agent",
      "type": "boolean"
    },
    {
      "key": "calc.agent_questions",
      "type": "array"
    },
    {
      "key": "calc.warnings",
      "type": "array"
    }
  ],
  "examples": [
    {
      "name": "min_cost 且 job金额>4050 -> 选job",
      "input": {
        "user": {
          "objective": "min_cost"
        },
        "calc": {
          "subsidy": {
            "4050_eligible": true,
            "job_eligible": true,
            "4050_amount_est": 700,
            "job_amount_est": 1200
          }
        }
      },
      "expected": {
        "calc": {
          "subsidy": {
            "selected_option": "job_subsidy"
          }
        }
      }
    }
  ],
  "evidence": [
    {
      "document_id": "DOC-SH-UI-OLDER-SUBSIDY-EXCLUSION-2025",
      "jurisdiction_code": "310000",
      "title": "大龄领取失业保险金人员参加企业职工基本养老保险期间可否享受本市“灵活就业人员”相关社会保险补贴及岗位补贴？（上海市人力资源和社会保障局）",
      "authority": "上海市人力资源和社会保障局",
      "official_url": "https://rsj.sh.gov.cn/tlqtj_17563/20250120/t0035_1430069.html",
      "fetched_at": "2026-09-11T03:56:23.496Z",
      "content_sha256": "1fd7e2f2cbfa1346a98ffd3a0467792949338473bd1cb3efa32387e2f1ef0883",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/310000/DOC-SH-UI-OLDER-SUBSIDY-EXCLUSION-2025/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "body",
        "reference": "答"
      },
      "excerpt": "不可以，大龄领取失业保险金人员参加企业职工基本养老保险期间不可同时享受本市“灵活就业人员”相关社会保险补贴及岗位补贴。"
    },
    {
      "document_id": "DOC-SH-EMPLOYMENT-ASSISTANCE-2022",
      "jurisdiction_code": "310000",
      "title": "关于进一步做好本市就业援助工作的若干意见（沪人社规〔2022〕8号）",
      "authority": "上海市人力资源和社会保障局 上海市财政局 上海市民政局 上海市残疾人联合会",
      "official_url": "https://rsj.sh.gov.cn/tjypx_17728/20220311/t0035_1406349.html",
      "fetched_at": "2026-09-11T04:01:44.294Z",
      "content_sha256": "c926b5086af8fa4217b388e613d3f569e49081457b01513e236fcd16278e55cd",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/310000/DOC-SH-EMPLOYMENT-ASSISTANCE-2022/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "paragraph",
        "reference": "二"
      },
      "excerpt": "补贴所需资金从失业保险基金中列支。“就业困难人员”享受补贴期满的，取消“就业困难人员”身份。"
    }
  ],
  "operation": "add"
}
