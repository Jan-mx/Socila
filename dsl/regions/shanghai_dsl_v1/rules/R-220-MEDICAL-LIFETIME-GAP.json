{
  "dsl_version": "SOCILA-DSL-1.0",
  "rule_id": "R-220-MEDICAL-LIFETIME-GAP",
  "name": "计算医保终身待遇年限缺口（性别区分）",
  "module": "medical_insurance",
  "status": "published",
  "priority": 220,
  "effective_from": "2025-01-01",
  "effective_to": null,
  "supersedes": [],
  "notes": "上海医保终身待遇：男性需25年，女性需20年（含视同缴费年限）。拆分为男/女两行。",
  "inputs": [
    {
      "key": "user.basic.gender",
      "type": "string",
      "required": true
    },
    {
      "key": "user.social.medical_contrib_months",
      "type": "number",
      "required": true
    }
  ],
  "parameter_refs": [
    { "param_id": "P-SH-MEDICAL-LIFETIME-MALE-YEARS", "purpose": "男性终身医保所需年限" },
    { "param_id": "P-SH-MEDICAL-LIFETIME-FEMALE-YEARS", "purpose": "女性终身医保所需年限" }
  ],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_missing",
        "when": {
          "or": [
            { "==": [{ "var": "user.social.medical_contrib_months" }, null] },
            { "==": [{ "var": "user.basic.gender" }, null] }
          ]
        },
        "then": {
          "actions": [
            { "type": "set", "path": "calc.needs_agent", "value": true },
            {
              "type": "emit_question",
              "value": {
                "question_id": "Q-MI-MONTHS",
                "text": "请提供医保累计缴费月数和性别（用于判断是否满足终身医保条件）。",
                "field": "user.social.medical_contrib_months"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_2_male",
        "when": {
          "and": [
            { "==": [{ "var": "user.basic.gender" }, "male"] },
            { "!=": [{ "var": "user.social.medical_contrib_months" }, null] }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.mi.lifetime_required_months",
              "value": { "*": [{ "var": "params.P-SH-MEDICAL-LIFETIME-MALE-YEARS" }, 12] }
            },
            {
              "type": "set",
              "path": "calc.mi.lifetime_gap_months",
              "value": {
                "max": [0, { "-": [{ "var": "calc.mi.lifetime_required_months" }, { "var": "user.social.medical_contrib_months" }] }]
              }
            }
          ]
        }
      },
      {
        "row_id": "row_3_female",
        "when": {
          "and": [
            { "==": [{ "var": "user.basic.gender" }, "female"] },
            { "!=": [{ "var": "user.social.medical_contrib_months" }, null] }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.mi.lifetime_required_months",
              "value": { "*": [{ "var": "params.P-SH-MEDICAL-LIFETIME-FEMALE-YEARS" }, 12] }
            },
            {
              "type": "set",
              "path": "calc.mi.lifetime_gap_months",
              "value": {
                "max": [0, { "-": [{ "var": "calc.mi.lifetime_required_months" }, { "var": "user.social.medical_contrib_months" }] }]
              }
            }
          ]
        }
      }
    ]
  },
  "outputs": [
    { "key": "calc.mi.lifetime_gap_months", "type": "number" },
    { "key": "calc.mi.lifetime_required_months", "type": "number" }
  ],
  "examples": [
    {
      "name": "男性已缴200月，需300月 -> 缺100月",
      "input": {
        "user": { "basic": { "gender": "male" }, "social": { "medical_contrib_months": 200 } },
        "params": { "P-SH-MEDICAL-LIFETIME-MALE-YEARS": 25 }
      },
      "expected": { "calc": { "mi": { "lifetime_gap_months": 100, "lifetime_required_months": 300 } } }
    },
    {
      "name": "女性已缴200月，需240月 -> 缺40月",
      "input": {
        "user": { "basic": { "gender": "female" }, "social": { "medical_contrib_months": 200 } },
        "params": { "P-SH-MEDICAL-LIFETIME-FEMALE-YEARS": 20 }
      },
      "expected": { "calc": { "mi": { "lifetime_gap_months": 40, "lifetime_required_months": 240 } } }
    },
    {
      "name": "女性已缴240月，需240月 -> 无缺口",
      "input": {
        "user": { "basic": { "gender": "female" }, "social": { "medical_contrib_months": 240 } },
        "params": { "P-SH-MEDICAL-LIFETIME-FEMALE-YEARS": 20 }
      },
      "expected": { "calc": { "mi": { "lifetime_gap_months": 0, "lifetime_required_months": 240 } } }
    }
  ],
  "evidence": []
}
