{
  "dsl_version": "SOCILA-DSL-1.0",
  "rule_id": "R-521-JOB-SUBSIDY-AMOUNT",
  "name": "大龄岗位补贴金额估算（最低工资 * 比例）",
  "module": "subsidy",
  "status": "published",
  "priority": 521,
  "effective_from": "2024-01-01",
  "effective_to": null,
  "supersedes": [],
  "notes": "岗位补贴=本市月最低工资标准的50%（沪人社规〔2022〕8号二）。",
  "inputs": [
    {
      "key": "calc.subsidy.job_eligible",
      "type": "boolean",
      "required": true
    }
  ],
  "parameter_refs": [
    {
      "param_id": "P-SH-MIN-WAGE",
      "purpose": "当期月最低工资标准（元/月）"
    },
    {
      "param_id": "P-SH-JOB-SUBSIDY-RATE-MINWAGE",
      "purpose": "岗位补贴比例（最低工资的50%）"
    }
  ],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_not_eligible",
        "when": {
          "or": [
            {
              "==": [
                {
                  "var": "calc.subsidy.job_eligible"
                },
                false
              ]
            },
            {
              "==": [
                {
                  "var": "calc.subsidy.job_eligible"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.job_amount_est",
              "value": 0
            }
          ]
        }
      },
      {
        "row_id": "row_2_params_missing",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "calc.subsidy.job_eligible"
                },
                true
              ]
            },
            {
              "or": [
                {
                  "==": [
                    {
                      "var": "params.P-SH-MIN-WAGE"
                    },
                    null
                  ]
                },
                {
                  "==": [
                    {
                      "var": "params.P-SH-JOB-SUBSIDY-RATE-MINWAGE"
                    },
                    null
                  ]
                }
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.job_amount_est",
              "value": null
            },
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_warning",
              "value": {
                "warning_id": "W-JOB-SUBSIDY-PARAM-MISSING",
                "text": "缺少有效月最低工资或岗位补贴比例参数，无法估算岗位补贴金额。"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_3_compute",
        "when": {
          "==": [
            {
              "var": "calc.subsidy.job_eligible"
            },
            true
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.subsidy.job_amount_est",
              "value": {
                "/": [
                  {
                    "floor": [
                      {
                        "+": [
                          {
                            "*": [
                              {
                                "*": [
                                  {
                                    "var": "params.P-SH-MIN-WAGE"
                                  },
                                  {
                                    "var": "params.P-SH-JOB-SUBSIDY-RATE-MINWAGE"
                                  }
                                ]
                              },
                              100
                            ]
                          },
                          0.5
                        ]
                      }
                    ]
                  },
                  100
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "calc.subsidy.job_amount_est",
      "type": "number"
    },
    {
      "key": "calc.needs_agent",
      "type": "boolean"
    },
    {
      "key": "calc.warnings",
      "type": "array"
    }
  ],
  "examples": [
    {
      "name": "最低工资2740、比例50% -> 1370",
      "input": {
        "calc": {
          "subsidy": {
            "job_eligible": true
          }
        },
        "params": {
          "P-SH-MIN-WAGE": 2740,
          "P-SH-JOB-SUBSIDY-RATE-MINWAGE": 0.5
        }
      },
      "expected": {
        "calc": {
          "subsidy": {
            "job_amount_est": 1370
          }
        }
      }
    }
  ],
  "evidence": [
    {
      "document_id": "DOC-SH-EMPLOYMENT-ASSISTANCE-2022",
      "jurisdiction_code": "310000",
      "title": "关于进一步做好本市就业援助工作的若干意见（沪人社规〔2022〕8号）",
      "authority": "上海市人力资源和社会保障局 上海市财政局 上海市民政局 上海市残疾人联合会",
      "official_url": "https://rsj.sh.gov.cn/tjypx_17728/20220311/t0035_1406349.html",
      "fetched_at": "2026-09-11T04:01:44.294Z",
      "content_sha256": "c926b5086af8fa4217b388e613d3f569e49081457b01513e236fcd16278e55cd",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/310000/DOC-SH-EMPLOYMENT-ASSISTANCE-2022/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "paragraph",
        "reference": "二"
      },
      "excerpt": "岗位补贴的标准为本市月最低工资标准的50%，社会保险补贴标准为以缴费当月职工社会保险缴费基数的下限作为基数计算的养老、医疗和失业保险缴费额中用人单位承担部分的50%。"
    },
    {
      "document_id": "DOC-SH-MIN-WAGE-2025",
      "jurisdiction_code": "310000",
      "title": "上海市人力资源和社会保障局关于调整本市最低工资标准的通知（沪人社规〔2025〕10号）",
      "authority": "上海市人力资源和社会保障局",
      "official_url": "https://rsj.sh.gov.cn/tgzfl_17732/20250714/t0035_1434097.html",
      "fetched_at": "2026-09-11T03:39:54.218Z",
      "content_sha256": "e158ad6970069a6cff47f7f5384770fc966132e6b6c0d11c719abb19422e6fcd",
      "artifact": "docs/refactor/policy-ops-agent/reports/stage-09-05-national-baseline-overlays/evidence/310000/DOC-SH-MIN-WAGE-2025/original.html",
      "parse_version": "extracted-text-v1",
      "locator": {
        "type": "paragraph",
        "reference": "一"
      },
      "excerpt": "一、月最低工资标准从2690元调整到2740元。"
    }
  ],
  "operation": "add"
}
