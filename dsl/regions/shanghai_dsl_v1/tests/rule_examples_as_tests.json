{
  "tests": [
    {
      "rule_id": "R-310-MI-WAITING-PERIOD",
      "example_name": "断缴2个月 <=3 -> 0等待期",
      "input": {
        "calc": {
          "mi": {
            "gap_months": 2
          }
        },
        "params": {
          "P-SH-MI-GAP-WAIVER-MONTHS": 3,
          "P-SH-MI-WAITING-PERIOD-MONTHS": 6
        }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "mi": {
            "waiting_period_months": 0,
            "waiting_required": false
          }
        }
      }
    },
    {
      "rule_id": "R-310-MI-WAITING-PERIOD",
      "example_name": "断缴5个月 -> 6个月等待期",
      "input": {
        "calc": {
          "mi": {
            "gap_months": 5
          }
        },
        "params": {
          "P-SH-MI-GAP-WAIVER-MONTHS": 3,
          "P-SH-MI-WAITING-PERIOD-MONTHS": 6
        }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "mi": {
            "waiting_period_months": 6,
            "waiting_required": true
          }
        }
      }
    },
    {
      "rule_id": "R-500-4050-ELIGIBILITY",
      "example_name": "已认定就业困难 + 灵活就业 -> eligible",
      "input": {
        "user": {
          "subsidy": {
            "has_employment_difficulty_cert": true
          },
          "status": {
            "employment_status": "flexible"
          }
        }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "subsidy": {
            "4050_eligible": true
          }
        }
      }
    },
    {
      "rule_id": "R-510-4050-AMOUNT",
      "example_name": "下限基数5000，比例0.3，补贴50% -> 750",
      "input": {
        "calc": {
          "subsidy": {
            "4050_eligible": true
          }
        },
        "user": {
          "social": {
            "base_lower_amount_per_month": 5000
          }
        },
        "params": {
          "P-SH-PENSION-RATE-FLEX": 0.2,
          "P-SH-MEDICAL-RATE-FLEX": 0.1,
          "P-SH-4050-SUBSIDY-RATE": 0.5
        }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "subsidy": {
            "flex_cost_est": 1500,
            "4050_amount_est": 750
          }
        }
      }
    },
    {
      "rule_id": "R-520-JOB-SUBSIDY-ELIGIBILITY",
      "example_name": "距退休30个月且就业困难 -> eligible",
      "input": {
        "user": {
          "subsidy": {
            "months_to_legal_retire": 30,
            "has_employment_difficulty_cert": true
          }
        }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "subsidy": {
            "job_eligible": true
          }
        }
      }
    },
    {
      "rule_id": "R-521-JOB-SUBSIDY-AMOUNT",
      "example_name": "最低工资2690，比例50% -> 1345",
      "input": {
        "calc": {
          "subsidy": {
            "job_eligible": true
          }
        },
        "user": {
          "social": {
            "min_wage_amount_per_month": 2690
          }
        },
        "params": {
          "P-SH-JOB-SUBSIDY-RATE-MINWAGE": 0.5
        }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "subsidy": {
            "job_amount_est": 1345
          }
        }
      }
    },
    {
      "rule_id": "R-530-OLDER-UI-PENSION-FUND-COVERAGE",
      "example_name": "领失业金且距退休10个月 -> eligible",
      "input": {
        "user": {
          "status": {
            "on_unemployment_benefit": true
          },
          "subsidy": {
            "months_to_legal_retire": 10
          }
        }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "subsidy": {
            "older_ui_pension_fund_eligible": true
          }
        }
      }
    },
    {
      "rule_id": "R-540-SUBSIDY-MUTUAL-EXCLUSION",
      "example_name": "min_cost 且 job金额>4050 -> 选job",
      "input": {
        "user": {
          "objective": "min_cost"
        },
        "calc": {
          "subsidy": {
            "4050_eligible": true,
            "job_eligible": true,
            "4050_amount_est": 700,
            "job_amount_est": 1200
          }
        }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "subsidy": {
            "selected_option": "job_subsidy"
          }
        }
      }
    },
    {
      "rule_id": "R-600-PAY-GAP-REMINDER",
      "example_name": "缴费月份包含7 -> 需要补差提醒",
      "input": {
        "user": {
          "social": {
            "paid_months_in_year": [
              6,
              7,
              8
            ]
          }
        }
      },
      "params_override": null,
      "expected": {
        "calc": {
          "contribution": {
            "pay_gap_needed": true
          }
        }
      }
    }
  ]
}
