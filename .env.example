# 数据库（必填）
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# 认证与后台登录（必填）
NEXTAUTH_SECRET=replace-with-a-random-secret
# 刷新会话 HMAC pepper（ADR-0007 / 09-03 PMG-FR-032）：必填，且必须与 NEXTAUTH_SECRET 不同
AUTH_REFRESH_PEPPER=replace-with-a-different-random-secret
NEXTAUTH_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$12$replace-with-a-bcrypt-password-hash

# 智能服务（API Key 和模型必填；OPENAI_URL 留空时使用官方 API）
OPENAI_URL=
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4o-mini
