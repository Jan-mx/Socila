# Socila 宿主机运行环境模板（09-03 整改后口径）
# 用法：复制为 .env.local 并填入真实值（.env.local 优先、.env 回退、进程变量不覆盖）。
# 宿主机脚本与 Next.js 只连接本地 Compose PostgreSQL（CFG-FR-001）：
#   主机固定 localhost:5432，库名 policyops。
# .env* 已被 .gitignore 忽略，绝不入库/入镜像；本模板只有占位符，可安全提交。

# 数据库（必填）：本地 Compose PostgreSQL（socila-postgres，宿主端口 5432）
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/policyops

# 认证（必填；与 Docker 运行时保持相同 NEXTAUTH_SECRET 与 AUTH_REFRESH_PEPPER）
NEXTAUTH_SECRET=replace-with-a-random-secret
# 刷新会话 HMAC pepper（ADR-0007）：必填，且必须与 NEXTAUTH_SECRET 不同
AUTH_REFRESH_PEPPER=replace-with-a-different-random-secret
NEXTAUTH_URL=http://localhost:3000

# 智能服务（API Key 和模型必填；OPENAI_URL 留空时使用官方 API）
OPENAI_URL=
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=replace-with-a-model-name

# 管理员为一次性引导（不常驻环境文件，CFG-FR-004）：以显式进程变量传入
# 管理员用户名与 bcrypt cost 12 哈希后执行 node scripts/bootstrap-admin.mjs
# （node -e "const b=require('bcryptjs'); b.hash('yourpassword',12).then(console.log)"
#  生成哈希），引导成功后运行时登录只查询 users 表。
