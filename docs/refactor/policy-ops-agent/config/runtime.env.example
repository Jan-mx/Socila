# Agent Runtime 运行配置模板（09-03 CFG-FR-010 整改后口径）
# 只列出运行时代码实际读取的变量（AGENT_ 前缀 pydantic Settings + 直接读取）；
# 模板只有占位符，可安全提交。Compose 部署时由 infra/prod/.env 统一提供，
# 本模板用于非 Compose（开发机 uv run / 服务器调试）场景。

# ── 存储与队列 ────────────────────────────────────────────────────────────
# Agent 库连接串（默认回退 DATABASE_URL / 本地演练库；Compose 内为 postgres:5432）
AGENT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB
AGENT_REDIS_URL=redis://:PASSWORD@HOST:6379/0
# Next Core 内部 API（服务身份；Compose 内为 http://web:3000）
AGENT_CORE_BASE_URL=http://localhost:3000

# ── MinIO（政策原件/RAG 文档对象存储；ENDPOINT 必填）────────────────────
AGENT_MINIO_ENDPOINT=localhost:9000
AGENT_MINIO_ACCESS_KEY=CHANGE_ME
AGENT_MINIO_SECRET_KEY=CHANGE_ME_STRONG
# 可选（默认 policyops / 关闭 TLS）
# AGENT_MINIO_BUCKET=policyops
# AGENT_MINIO_SECURE=false

# ── SiliconFlow（RAG：BAAI/bge-m3 向量、rerank、PaddleOCR-VL）────────────
SILICONFLOW_API_KEY=sk-CHANGE_ME
# 可选（默认官方端点与实测模型/维度）
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
# SILICONFLOW_EMBEDDING_DIMENSIONS=1024
# SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_RERANK_MIN_SCORE=0.3

# ── 服务身份 JWT（Core↔Agent 内部签名；双档支持轮换）────────────────────
# 保留配置供后续服务 JWT Feature 接线；本 Stage 不实现（09-03 非目标）
AGENT_SERVICE_JWT_CURRENT=CHANGE_ME_RANDOM
AGENT_SERVICE_JWT_PREVIOUS=CHANGE_ME_RANDOM

# ── 一次性运维输入（非常驻运行变量）──────────────────────────────────────
# AGENT_DB_PASSWORD=agent_app 角色口令，仅 python -m agent.migrate --with-roles 需要

# ── 固定值（不列为环境变量）──────────────────────────────────────────────
# Worker：concurrency=1、prefetch=1、max_tasks_per_child=20、120s 默认任务超时
# （compose 内置；资源预算与格式上限见 OPERATIONS.md 服务预算/资源保护）
