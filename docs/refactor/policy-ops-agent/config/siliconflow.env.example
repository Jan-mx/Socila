SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=

SILICONFLOW_MODELS_PATH=/models

SILICONFLOW_EMBEDDINGS_PATH=/embeddings
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_DIMENSIONS=1024

SILICONFLOW_RERANK_PATH=/rerank
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

SILICONFLOW_OCR_PATH=/chat/completions
SILICONFLOW_OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
OCR_PROVIDER=siliconflow
OCR_MAX_CONCURRENCY=1
OCR_MAX_FILE_MB=50
OCR_MAX_PAGES=200
OCR_PAGE_TIMEOUT_SECONDS=120
OCR_PUBLIC_POLICY_ONLY=true

SILICONFLOW_CONNECT_TIMEOUT_SECONDS=10
SILICONFLOW_REQUEST_TIMEOUT_SECONDS=60
SILICONFLOW_MAX_RETRIES=3
