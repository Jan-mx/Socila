# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.omc/
.env.local
.tmp-playwright/
test-results/
/.git.previous-before-socila-reset/
/.claude/

# evaluation artifacts
/.evaluation-tmp/
/evaluation-reports/

/docs/interview/
/docs/refactor/policy-ops-agent/config/*.local.env

# secret gate（FND-FR-008/010）：密钥、私钥、凭据与备份不入库
*.key
id_rsa*
credentials*.json
secrets.*
*.dump
*.bak
*.backup
