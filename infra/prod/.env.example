# Socila 单机部署环境模板（部署到服务器时：复制为同目录 .env 并填入真实值）
# .env 已被 .gitignore 忽略，绝不入库/入镜像；本模板只有占位符，可安全提交。
# 密码生成：openssl rand -hex 16（密码）/ openssl rand -base64 32（密钥）

# ── PostgreSQL（容器 socila-postgres；容器网络内主机名固定为 postgres）────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=policyops
# Core(web) 与 Agent 的连接串：主机名必须写 postgres（容器 DNS），不是 localhost
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG@postgres:5432/policyops
AGENT_DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG@postgres:5432/policyops

# ── MinIO（容器 socila-minio；政策原件/RAG 文档对象存储）─────────────────────
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG

# ── 认证（NextAuth v5 + Credentials 管理员）──────────────────────────────────
NEXTAUTH_SECRET=CHANGE_ME_RANDOM_32
# 服务器用 https 域名；内网 IP 访问则 http://<服务器IP>
NEXTAUTH_URL=https://your-domain.example
ADMIN_USERNAME=Jan
# bcrypt 哈希（60 字符）。注意：本文件经 compose 变量插值，每个 $ 必须写成 $$！
# 生成：node -e "console.log(require('bcryptjs').hashSync('你的密码',10))" 再把 $ 全部替换为 $$
ADMIN_PASSWORD_HASH=$$2b$$10$$CHANGE_ME

# ── LLM（OpenAI 兼容端点；当前 DeepSeek）────────────────────────────────────
OPENAI_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=deepseek-v4-flash

# ── Agent 服务身份 JWT（Core↔Agent 内部签名；双档支持轮换）───────────────────
AGENT_SERVICE_JWT_CURRENT=CHANGE_ME_RANDOM
AGENT_SERVICE_JWT_PREVIOUS=CHANGE_ME_RANDOM

# ── SiliconFlow（RAG：BAAI/bge-m3 向量、rerank、PaddleOCR-VL）────────────────
SILICONFLOW_API_KEY=sk-CHANGE_ME

# ── 入口（Caddy，可选）───────────────────────────────────────────────────────
# 设置后 Caddy 自动签发 HTTPS(443)；不设置默认 :80（内网/HTTP）
# SITE_ADDRESS=your-domain.example

# ── 不需要配置的项（compose 内置，仅列备忘）─────────────────────────────────
# Redis：redis://redis:6379/0（内网隔离，无凭据）
# Agent→Core：http://web:3000；Agent→MinIO：minio:9000；Agent 健康：8100
